{
    "name": "infrangible/m2-etrusted-hyva",
    "description": "Makes the eTrusted rating and review widgets work in stores that use the Hyvä theme, with the review list shown in Hyvä's own slider.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Hyvä",
        "Integrations",
        "Content",
        "Hyvä support for eTrusted",
        "Trusted Shops reviews for Hyvä"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-etrusted-hyva",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~102.0.0|~103.0.0",
        "infrangible/m2-etrusted": "~2.1.0",
        "hyva-themes/magento2-compat-module-fallback": "*"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\ETrustedHyva\\": "src"
        }
    }
}
